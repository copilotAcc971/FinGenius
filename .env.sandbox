# SANDBOX ENVIRONMENT CONFIGURATION
# For E2E testing of ASP and FATOORAH integrations
# Copy to .env.local and adjust as needed

# ==============================================================================
# UAE PEPPOL (ASP) SANDBOX CONFIGURATION
# ==============================================================================

# ASP Testing Mode - Uses mock service for testing
UAE_PEPPOL_ASP_ENDPOINT=http://localhost:5000/api/testing/asp
UAE_PEPPOL_ASP_API_KEY=sandbox-asp-key-test
UAE_PEPPOL_ASP_SECRET=sandbox-asp-secret-test
UAE_PEPPOL_TESTING_MODE=true

# Optional: Configure real ASP endpoint
# UAE_PEPPOL_ASP_ENDPOINT=https://your-asp-provider.com/api/v1
# UAE_PEPPOL_ASP_API_KEY=your-real-asp-api-key
# UAE_PEPPOL_ASP_SECRET=your-real-asp-secret
# UAE_PEPPOL_TESTING_MODE=false

# ==============================================================================
# KSA ZATCA (FATOORAH) SANDBOX CONFIGURATION
# ==============================================================================

# FATOORAH Sandbox Mode - Official ZATCA sandbox environment
KSA_ZATCA_SANDBOX=true
KSA_ZATCA_API_KEY=sandbox-fatoorah-key-test

# FATOORAH Sandbox URLs (Official):
# Sandbox Endpoint: https://sandbox.fatoorah.sa/api
# Production Endpoint: https://api.fatoorah.sa/api
# Documentation: https://zatca.gov.sa/en/E-Invoicing/

# Optional: Configure production FATOORAH
# KSA_ZATCA_SANDBOX=false
# KSA_ZATCA_API_KEY=your-real-fatoorah-api-key

# ==============================================================================
# TESTING CONFIGURATION
# ==============================================================================

# E2E Testing Flags
TESTING_ENABLED=true
TESTING_MODE=sandbox

# Invoice Testing Sample Data
TESTING_SAMPLE_CUSTOMER_TIN=3100127812300003
TESTING_SAMPLE_SUPPLIER_TIN=3100127812300004

# Timeout Configuration (milliseconds)
TESTING_ASP_TIMEOUT=5000
TESTING_FATOORAH_TIMEOUT=10000

# Verbose Logging for Testing
TESTING_LOG_VERBOSE=true
TESTING_LOG_REQUESTS=true
TESTING_LOG_RESPONSES=true

# ==============================================================================
# DATABASE (Keep existing configuration)
# ==============================================================================
DATABASE_URL=postgresql://...

# ==============================================================================
# APPLICATION
# ==============================================================================
NODE_ENV=development
PORT=5000
